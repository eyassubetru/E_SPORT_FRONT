{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
   "rewrites": [
      {
        "source": "/authApi/**",
        "function": {
          "id": "authApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/eStreamApi/**",
        "function": {
          "id": "eStreamApi",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}